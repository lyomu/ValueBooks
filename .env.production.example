# ValueBooks production environment -- template for /srv/valuebooks/prod/.env.production
# on the dedicated box (161.97.140.207). Copy, fill in, chmod 600. Never commit the
# filled-in file.
#
# scripts/deploy.sh refuses to deploy if any required value here is missing or empty,
# so a gap fails fast instead of becoming a crash-looping container at 3am.
#
# Values NOT listed here are supplied by docker-compose.prod.yml's own `environment:`
# blocks (NODE_ENV, API_PORT, REDIS_URL, CLAMAV_HOST, CLAMAV_PORT) or fall back to the
# production defaults in packages/config/src/index.ts. Note that file's LOCAL_DEFAULTS
# apply ONLY when NODE_ENV != production -- in production there is no safety net, which
# is why this list is long.

# --- Database -----------------------------------------------------------------------
# POSTGRES_USER is the cluster superuser and ends up owning every migrated table.
# The API must NOT connect as it: apps/api/src/database/database-role.guard.ts rejects
# a superuser / BYPASSRLS / AI-table-owning role at boot, because PostgreSQL RLS (which
# protects ai_runs and ai_evidence) is silently bypassed by exactly those roles.
#
# So there are two URLs, by design:
#   DATABASE_MIGRATION_URL -> POSTGRES_USER, privileged, used by Prisma CLI/migrations
#   DATABASE_URL           -> valuebooks_app, restricted, used by the running API
#
# valuebooks_app is created on first boot by infrastructure/postgres-init-prod.sh from
# VALUEBOOKS_APP_PASSWORD. The database initializes exactly ONCE: if these passwords
# disagree, fixing it means destroying the postgres_data volume. Set them carefully.
POSTGRES_DB=valuebooks
POSTGRES_USER=valuebooks
POSTGRES_PASSWORD=
VALUEBOOKS_APP_PASSWORD=

# Host is the compose service name `postgres`, not localhost -- these run in the
# compose network. Keep the password halves in sync with the two values above.
DATABASE_URL=postgresql://valuebooks_app:<VALUEBOOKS_APP_PASSWORD>@postgres:5432/valuebooks
DATABASE_MIGRATION_URL=postgresql://valuebooks:<POSTGRES_PASSWORD>@postgres:5432/valuebooks

# --- Security -------------------------------------------------------------------------
# Must be >= 32 characters, and the validator explicitly rejects the known placeholder
# values. Generate on the box, don't paste one from a chat log:
#   openssl rand -base64 48
# Changing this later invalidates everything derived from it. Treat it as permanent.
SECURITY_PEPPER=

# --- URLs -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL is baked into the web image at BUILD time by the Jenkinsfile
# (currently https://api.valuebooks.co); the value here must match it or the browser
# will call the wrong origin.
NEXT_PUBLIC_API_URL=https://api.valuebooks.co
WEB_APP_URL=https://valuebooks.co

# --- Object storage (Cloudflare R2) -----------------------------------------------------
# Deliberately NOT self-hosted: docker-compose.prod.yml has no minio service, unlike the
# local dev compose. Self-hosting would leave this platform's financial documents in one
# place with no backup story. See devops-infra/docs/VALUEBOOKS_DEDICATED_BOX_PROVISIONING.md.
#
# R2 is S3-API compatible and needs no code changes: the app uses only PutObject,
# GetObject, DeleteObject, HeadBucket, CreateBucket, ListBuckets and presigned GETs, and
# already sets forcePathStyle: true. It uses no ACLs, versioning or storage classes --
# precisely the things R2 does not implement.
#
# S3_REGION must be literally `auto` for R2.
# Create the bucket in the dashboard first: StorageService.ensureBucket() would otherwise
# try CreateBucket, which a bucket-scoped API token cannot do.
#
# Note: /health/ready probes storage with ListBuckets (an account-level call), so a
# bucket-scoped token makes readiness report `minio: down`. This does NOT block the
# deploy -- the container healthcheck and Jenkins smoke test both use /api/v1/health
# (liveness), which never touches S3. Grant account-level read if you want it green.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=valuebooks-prod

# --- Email ------------------------------------------------------------------------------
# No production default exists for SMTP_HOST or EMAIL_FROM; the API will not boot without
# them. SMTP_PORT defaults to 587 and can be omitted.
SMTP_HOST=
SMTP_PORT=587
EMAIL_FROM=ValueBooks <no-reply@valuebooks.co>

# --- Optional ---------------------------------------------------------------------------
# Comma-separated. Grants platform-admin access, so keep it tight.
# PLATFORM_ADMIN_EMAILS=
# Defaults to `lyomu`; only set this if images are pushed to a different Docker Hub owner.
# DOCKERHUB_OWNER=lyomu
# AI features default to off. Turning them on has its own required-variable rules in
# packages/config/src/index.ts (private mode additionally demands https + an allow-list).
# AI_MODE=off
