NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
# The API uses the restricted runtime role. Prisma migrations use DATABASE_MIGRATION_URL instead.
DATABASE_URL=postgresql://valuebooks_app:valuebooks-app-local@localhost:55432/valuebooks
DATABASE_MIGRATION_URL=postgresql://valuebooks:valuebooks@localhost:55432/valuebooks
REDIS_URL=redis://localhost:56780
EMAIL_WORKER_CONCURRENCY=4
EMAIL_JOB_RETRY_DELAY_MS=1000
ALLOW_DEMO_SEED=false
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=valuebooks
S3_SECRET_KEY=valuebooks-local
S3_BUCKET=valuebooks-local
# Local ClamAV daemon used to scan Expense attachments before OCR/extraction (Phase 13D).
CLAMAV_HOST=localhost
CLAMAV_PORT=53310
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
EMAIL_FROM=ValueBooks <hello@valuebooks.local>
SECURITY_PEPPER=replace-with-at-least-32-random-characters

# Logging. Defaults to debug outside production, info in production.
# Set to "silent" to disable. Structured JSON is emitted in production; pino-pretty elsewhere.
LOG_LEVEL=debug

# Paddle (Starter subscriptions). Sandbox until EinsBrand Digital's $1/month recurring product and
# merchant account are approved for live charging -- see billing spec Section 5/39.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Paystack (Growth/Professional/Advanced subscriptions). Use the test secret key until live USD
# and recurring-authorization readiness is confirmed for the merchant account.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Subscription/trial behavior. Trial length itself is the ACTIVE Professional plan's `trialDays`
# column (seeded to 14, i.e. 336h, by the plan-catalog migration) -- this only controls how far
# before expiry the one-time reminder email fires.
BILLING_TRIAL_REMINDER_LEAD_HOURS=24
